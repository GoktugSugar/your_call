# Godot 4+ specific ignores
.godot/
/android/

# Exports
/export/
/builds/

# Secrets and local config. The ElevenLabs key lives in the environment or in .env, never in git.
.env
.env.*
/secrets/

# Python tooling
__pycache__/
.venv/

# OS and editor clutter
.DS_Store
Thumbs.db
.vscode/
.idea/

# Voice auditions and sound effect takes are scratch audio for choosing by ear, not game assets
/voice_auditions/
/sfx_auditions/
/music_auditions/

# Placeholder music of unknown licence: played locally, never published
/assets/audio/music/bgm_placeholder.mp3
/assets/audio/music/bgm_placeholder.mp3.import

# Helper worktrees made while developing; Godot is kept out of them by .claude/.gdignore
/.claude/worktrees/
