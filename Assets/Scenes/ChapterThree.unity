  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.PriceableBeat
  _note: 
  _mode: 0
  _itemName: 'Feel Nothing'
  _price: 2800
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _doodleKind: 35
  _boughtSeed: 34
  _passedSeed: 66
  _statsHeading: how others chose
  _boughtLabel: bought it
  _passedLabel: kept the money
  _profileAxis: 4
  _buyNudge: -0.05
  _passNudge: 0
  _pitch: 'Feel Nothing. Never grief, never heartbreak, never that particular ache again. [amber]{0}[/amber]. Peace. Of a kind. Buy it?'
  _buyReact: 'Bought. No more heartbreak. Also no more joy at full volume, no more anything at full volume, it is the very same dial, you cannot turn down only one half. A flat calm sea, forever. You chose it. Fascinating.'
  _passReact: 'Passed. You will keep the grief to keep the joy. A package deal, and you took the whole thing. More sentimental than you look, judge.'
  _brokeReact: 'With what? You feel that, the nothing where your money was. Cannot even numb it. On we go.'
  _teaseLine: 
  _buyLabel: Buy it
  _passLabel: Keep the money
