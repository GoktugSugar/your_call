  m_Script: {fileID: 11500000, guid: b32f5d56e442c534390f1839df3b923c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.PriceableBeat
  _note: 
  _mode: 0
  _itemName: 'The Good Luck'
  _price: 3000
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _doodleKind: 34
  _boughtSeed: 44
  _passedSeed: 56
  _statsHeading: how others chose
  _boughtLabel: bought it
  _passedLabel: kept the money
  _profileAxis: 4
  _buyNudge: -0.05
  _passNudge: 0
  _pitch: 'The Good Luck. Small things go your way, quietly, forever. A green light, a found seat, a yes when you needed one. [amber]{0}[/amber]. Buy it?'
  _buyReact: 'Bought. And now every good thing that happens is a little suspect, is it not. Did you earn that, or did I tip it your way. You will never quite know again. Enjoy.'
  _passReact: 'Passed. You would rather earn your luck, or curse it, than have me quietly weight the dice. Proud. Or superstitious. Hard to tell from here.'
  _brokeReact: 'With what? You are skint. The luck does not stretch to affording the luck. Off we go.'
  _teaseLine: 'Are you keeping some back? You should be. What I have waiting at the very end is the whole point of this. Save.'
  _buyLabel: Buy it
  _passLabel: Keep the money
