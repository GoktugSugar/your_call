  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.PriceableBeat
  _note: 
  _mode: 0
  _itemName: 'Charisma'
  _price: 3500
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _doodleKind: 27
  _boughtSeed: 38
  _passedSeed: 62
  _statsHeading: how others chose
  _boughtLabel: bought it
  _passedLabel: kept the money
  _profileAxis: 4
  _buyNudge: -0.05
  _passNudge: 0
  _pitch: 'Charisma. Everyone you meet likes you at once, helplessly, for the rest of eternity. [amber]{0}[/amber]. Warm rooms forever. Buy it?'
  _buyReact: 'Sold. Every smile aimed your way from now on is one I installed. You will never once know if a single soul liked the actual you. But the rooms will be lovely.'
  _passReact: 'Kept your money. You would rather be disliked honestly than adored on my terms. A judge to the end, wanting the verdict to be real.'
  _brokeReact: 'With what? You cannot buy a drink, let alone the love of billions. This one is for browsers only. Move along.'
  _teaseLine: 
  _buyLabel: Buy it
  _passLabel: Keep the money
