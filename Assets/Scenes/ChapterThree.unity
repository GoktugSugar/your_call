  m_Script: {fileID: 11500000, guid: b32f5d56e442c534390f1839df3b923c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.PriceableBeat
  _note: 
  _mode: 0
  _itemName: 'The Lie Detector'
  _price: 3200
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _doodleKind: 30
  _boughtSeed: 29
  _passedSeed: 71
  _statsHeading: how others chose
  _boughtLabel: bought it
  _passedLabel: kept the money
  _profileAxis: 4
  _buyNudge: -0.05
  _passNudge: 0
  _pitch: 'The Lie Detector. You will always know, instantly, the moment anyone lies to you. [amber]{0}[/amber]. Anyone at all. Buy it?'
  _buyReact: 'Bought. Every kind lie, gone. Every I am fine, every it is lovely, every I forgive you, laid bare the second it is false. You wanted the truth. You never once asked if you could live inside it.'
  _passReact: 'Passed. You would rather be lied to sweetly than know. A man who spent his life demanding truth from a stand, keeping his own little comforts. I do enjoy you.'
  _brokeReact: 'With what? You have nothing, and that is the truth, no detector required. On we go.'
  _teaseLine: 'Still saving for the finish? Good man. You have genuinely no idea what is coming. It is worth every penny you have left.'
  _buyLabel: Buy it
  _passLabel: Keep the money
