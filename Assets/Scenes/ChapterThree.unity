  m_Script: {fileID: 11500000, guid: b32f5d56e442c534390f1839df3b923c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.PriceableBeat
  _note: 
  _mode: 0
  _itemName: 'Ten More IQ'
  _price: 2500
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _doodleKind: 32
  _boughtSeed: 41
  _passedSeed: 59
  _statsHeading: how others chose
  _boughtLabel: bought it
  _passedLabel: kept the money
  _profileAxis: 4
  _buyNudge: -0.05
  _passNudge: 0
  _pitch: 'Ten more points of IQ. Meaningfully sharper, right now. [amber]{0}[/amber]. Smart enough to finally see it all. Buy it?'
  _buyReact: 'Done. Now you are clever enough to see precisely how wrong you were on the bench, and clever enough to watch everyone you love fail to keep up. A lonely little gift. You bought it anyway.'
  _passReact: 'Passed. Comfortable where you are, or frightened of what you might work out. Either way, you stay exactly this clever, forever.'
  _brokeReact: 'With what? No. You cannot afford it, and I will not insult the gift by discounting it. Watch this one go by.'
  _teaseLine: 'Getting close now. The last thing on offer makes all of this look like a warm up. Do hold something in reserve.'
  _buyLabel: Buy it
  _passLabel: Keep the money
