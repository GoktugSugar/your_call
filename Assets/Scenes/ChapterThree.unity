  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.PriceableBeat
  _note: 
  _mode: 0
  _itemName: 'Rewind'
  _price: 6000
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _doodleKind: 31
  _boughtSeed: 52
  _passedSeed: 48
  _statsHeading: how others chose
  _boughtLabel: bought it
  _passedLabel: kept the money
  _profileAxis: 4
  _buyNudge: -0.05
  _passNudge: 0
  _pitch: 'Rewind. Once, ever, you may undo a single decision from your life and take the other road instead. [amber]{0}[/amber]. Only the one. Buy it?'
  _buyReact: 'Bought. One chance to do it over. And I know exactly which night you are already picturing. The drink, the keys, the road. You did not even hesitate. Interesting, that you would spend the most on the thing that admits the most.'
  _passReact: 'Passed. Not one moment you would take back. Either at peace with all of it, or too proud to admit which one. The road, though. I saw you think about the road.'
  _brokeReact: 'With what? You would rewind to before you spent it all, I expect. You cannot. That is rather the theme of the day.'
  _teaseLine: 
  _buyLabel: Buy it
  _passLabel: Keep the money
