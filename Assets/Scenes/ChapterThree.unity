  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.PriceableBeat
  _note: 
  _mode: 0
  _itemName: 'Never Tired'
  _price: 2600
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _doodleKind: 33
  _boughtSeed: 33
  _passedSeed: 67
  _statsHeading: how others chose
  _boughtLabel: bought it
  _passedLabel: kept the money
  _profileAxis: 4
  _buyNudge: -0.05
  _passNudge: 0
  _pitch: 'Never sleep, never tire again. [amber]{0}[/amber]. All those hours you were wasting unconscious, handed back to you. Buy it?'
  _buyReact: 'Sold. No more sleep. No more little nightly death to hide inside. Just you, awake, forever, with you. I do hope you two get along.'
  _passReact: 'Kept it. You want your oblivion. Eight hours a night away from yourself, and you would pay to protect it. Telling.'
  _brokeReact: 'With what? You are penniless. And frankly you look like you could use the sleep. Next.'
  _teaseLine: 
  _buyLabel: Buy it
  _passLabel: Keep the money
