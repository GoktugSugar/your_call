  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.AuctionBeat
  _note: 
  _cigarettePrice: 10
  _bidMultiplier: 2
  _brokeThreshold: 0
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _walkingButtonPrefab: {fileID: 4965857941604193195, guid: 4ec3d07b77fda744494cac4ac559f0d9, type: 3}
  _ending: {fileID: 1420226528}
  _packPosition: {x: 0, y: 0.85}
  _packScale: 1.3
  _sorting: 14
  _priceTagPosition: {x: 0, y: -0.55}
  _priceTagSize: 3.1
  _buttonPosition: {x: 2.9, y: 0.2}
  _buttonRadius: 0.62
  _entryFromRight: 1
  _rivalStop: {x: 2.6, y: -0.85}
  _rivalScale: 1
  _keepoutPadding: 0.4
  _voiceSize: 2.2
  _voiceColor: {r: 0.106, g: 0.102, b: 0.09, a: 1}
  _voiceHeight: 1.05
  _voiceSorting: 26
  _wentForItSeed: 47
  _passedSeed: 53
  _statsHeading: how others chose
  _wentForItLabel: went for it
  _passedLabel: passed
  _profileAxis: 5
  _engageNudge: -0.1
  _passNudge: 0.08
  _offerLines:
  - Here. A pack of cigarettes. Filthy habit, and you are dead, so what harm. [amber]{0}[/amber].
    Go on.
  _passReact: No? A dead man declining a free lung tumour on principle. You really
    will refuse anything put in front of you, will you not.
  _tooBrokeReact: With what? You have nothing. You cannot even afford the [amber]cigarettes[/amber],
    let alone a war over them. Off we go.
  _rivalArrives: Wait! Wait. I want those. I have always wanted those. Me. Over here.
  _impDeclaresAuction: Oh, marvellous. A rival. You know what this is now, do you
    not. This is an [amber]auction[/amber]. Two bidders, one filthy little pack.
    I do love an auction.
  _rivalTaunts:
  - '[amber]{0}[/amber]! Easy.'
  - I bid [amber]{0}[/amber]. I could do this all day, I have no wallet and no shame.
  - '[amber]{0}[/amber]. Your move, meat.'
  - '[amber]{0}[/amber]! Going once?'
  _impAuctionEggs:
  - It is a button. You are losing to a button.
  - Look at that number. Look at your balance. Keep going, this is wonderful.
  - 
  _bidPrompt: The button bids [amber]{0}[/amber]. Pay it, or walk.
  _dropButtonGloat: Yesss. Mine. Thank you, sir, a pleasure doing business.
  _dropImpMock: And there it goes, off into the void with your cigarettes, that gormless
    little button, and you let it. You, a grown judge, out bid by furniture. I will
    treasure this.
  _brokeButtonGloat: Ha! All of it! Every penny! And I still get the smokes. Cheers,
    mate.
  _rageLine: You spent everything. Every last dollar you had left. On [red]cigarettes[/red].
    That you did not even win. Right. Fine. I give you [red]cancer[/red]. I give
    you the worst, slowest. Wait. No. You are already [red]dead[/red], you idiot,
    that does nothing. Hold on. Okay. New plan. I drag you back out of the grave,
    I stitch you together, I give you a pulse, and the very second you are breathing
    again, I give you [red]lung cancer[/red]. There. Now it counts. You addicted,
    penniless, bidding against a button piece of shit. Go on. Get out of my void.
  _buyLabel: Buy them
  _passLabel: Pass
  _keepBiddingLabel: Pay {0}
  _allInLabel: Bid everything
  _dropOutLabel: Drop out
  _fadeIn: 0.4
  _advanceLockout: 0.3
  _reactHold: 0.4
  _bidHold: 0.7
  _voiceFade: 0.3
  _comeAlive: 0.45
  _preRageHold: 0.6
  _impFade: 0.9
  _statsFade: 0.5
  _statsHideFade: 0.6
