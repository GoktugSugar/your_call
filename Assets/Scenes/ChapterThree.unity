  m_Script: {fileID: 11500000, guid: b32f5d56e442c534390f1839df3b923c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.PriceableBeat
  _note: 
  _mode: 0
  _itemName: 'No More Pain'
  _price: 4500
  _bulkMax: 50
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _doodleKind: 19
  _doodleOutline: {r: 0, g: 0, b: 0, a: 0}
  _doodlePosition: {x: 0, y: 0.85}
  _doodleScale: 1.35
  _sorting: 14
  _altDoodleKind: 0
  _altLanguage: 
  _priceTagPosition: {x: 0, y: -0.55}
  _priceTagSize: 3.1
  _priceTagFormat: '{0}'
  _buttonPosition: {x: 2.9, y: 0.2}
  _buttonRadius: 0.62
  _buttonColor: {r: 0.106, g: 0.102, b: 0.09, a: 1}
  _buttonHotColor: {r: 0.91, g: 0.584, b: 0.118, a: 1}
  _tallyPosition: {x: 0, y: 2.5}
  _tallySize: 2.8
  _tallyFormat: '{0} taken'
  _boughtSeed: 55
  _passedSeed: 45
  _statsHeading: how others chose
  _boughtLabel: bought it
  _passedLabel: kept the money
  _profileAxis: 4
  _buyNudge: -0.05
  _passNudge: 0
  _pitch: Never feel physical [red]pain[/red] again. Not a stubbed toe, not a broken
    bone, not the last thing you felt out there on that road. Ever. [amber]{0}[/amber].
    Sounds like an easy yes, until you sit with what pain is actually for. Buy it?
  _brandKey: 
  _buyReact: Done. No pain, ever again. Do enjoy never once knowing when something
    is wrong, right up until it is far too late to matter. A genuine bargain.
  _passReact: You kept your pain. On purpose. Would not pay a cent to be free of
    it. There is a whole philosophy in that, or you are simply stubborn. Both, most
    likely.
  _brokeReact: With what, exactly? You have nothing. You gave it all away. You get
    to just watch this one.
  _bulkTierLine: 
  _bulkStopReact: '[amber]{0}[/amber] years of some stranger, poured into you. You
    will not feel a single one of them. Marvellous.'
  _bulkZeroReact: Not one year. Too squeamish, or too cheap. Either reads the same
    from here.
  _buyLabel: Buy it
  _passLabel: Keep the money
  _bulkBuyLabel: Buy one
  _bulkStopLabel: Enough
  _flourishColor: {r: 0.91, g: 0.584, b: 0.118, a: 1}
  _flourishRadius: 0.8
  _flourishStrokes: 10
  _flourishWidth: 0.05
  _flourishDuration: 0.6
  _doodleFadeIn: 0.4
  _doodleFadeOut: 0.35
  _advanceLockout: 0.3
  _reactHold: 0.4
  _bulkTierHold: 1
  _statsFade: 0.5
  _statsHideFade: 0.6
