  m_Script: {fileID: 11500000, guid: b32f5d56e442c534390f1839df3b923c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.PriceableBeat
  _note: 
  _mode: 0
  _itemName: 'Perfect Memory'
  _price: 2800
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _doodleKind: 29
  _boughtSeed: 31
  _passedSeed: 69
  _statsHeading: how others chose
  _boughtLabel: bought it
  _passedLabel: kept the money
  _profileAxis: 4
  _buyNudge: -0.05
  _passNudge: 0
  _pitch: 'Perfect Memory. Forget nothing, ever again. [amber]{0}[/amber]. Every face, every name, every word. Buy it?'
  _buyReact: 'Sold. And every joy stays bright, yes. So does every humiliation, every cruelty, every thing you did that you have spent years letting blur. All of it, sharp, forever. There is no mercy in a perfect memory. You bought it anyway.'
  _passReact: 'Kept it. You like the forgetting. The soft edges. The things time was kindly sanding off you. Fair enough. Stay blurry.'
  _brokeReact: 'With what? You will not remember that you could not afford this, at least. A small mercy. Move on.'
  _teaseLine: 
  _buyLabel: Buy it
  _passLabel: Keep the money
