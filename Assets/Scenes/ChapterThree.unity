  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.PriceableBeat
  _note: 
  _mode: 0
  _itemName: 'The truth'
  _teaseLine: 'Right. One more after this. THE one. Everything so far was me clearing my throat. Whatever you have left, whatever it is, hold onto it.'
  _price: 900
  _bulkMax: 50
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _doodleKind: 38
  _doodleOutline: {r: 0, g: 0, b: 0, a: 0}
