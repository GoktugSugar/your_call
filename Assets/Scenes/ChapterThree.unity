  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.PriceableBeat
  _note: 
  _mode: 0
  _itemName: 'One More Voice'
  _price: 3400
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _doodleKind: 36
  _boughtSeed: 27
  _passedSeed: 73
  _statsHeading: how others chose
  _boughtLabel: bought it
  _passedLabel: kept the money
  _profileAxis: 4
  _buyNudge: -0.05
  _passNudge: 0
  _pitch: 'One More Voice. A wise voice in your head, always right, forever, whenever you ask it. [amber]{0}[/amber]. Never wrong again. Buy it?'
  _buyReact: 'Sold. Always right, always there. And slowly, quietly, you stop deciding anything at all yourself, because why would you, it is always right. A man who is never wrong, and never once truly chooses again. Rather perfect for you.'
  _passReact: 'Kept it. You would rather be wrong on your own than right on a lead. The judge wants to hold the gavel himself. Noted.'
  _brokeReact: 'With what? The voice would tell you to save your money. Which you did not have. Next.'
  _teaseLine: 'Almost there now. The big one is coming, the one I have been building to all along. Do not tell me you are about to run out.'
  _buyLabel: Buy it
  _passLabel: Keep the money
