  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.MenuImpBarker
  _bark: {fileID: 81099372}
  _imp: {fileID: 1269116347}
  _roamer: {fileID: 1269116349}
  _barks:
  - line: Still here, are we?
    expression: 2
  - line: You already know which one you will pick, and so do I.
    expression: 2
  - line: Take your time, no one is waiting for you now.
    expression: 0
  - line: A new game, as if the last one went so well for you.
    expression: 3
  - line: Go on, press something, I love to watch you decide.
    expression: 1
  - line: All this hovering, you were always a staller.
    expression: 2
  - line: Continue is greyed out, nothing back there for you.
    expression: 0
  - line: I can hear the little cogs grinding from here.
    expression: 1
  - line: Choose, or do not, it is all the same to me.
    expression: 0
  - line: You judged so many, and look who is squirming now.
    expression: 3
  _firstDelay: 3
  _pauseMin: 5
  _pauseMax: 9
  _holdAfterTyped: 2.2
  _restExpression: 0
  _barking: 1
