  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6e23c2a185e4f03b5e250341fb40b87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.WantsYouToBeat
  _note: 17_WantsYouTo
  _kit: {fileID: 5000000000000000012}
  _advanceLockout: 0.3
  _reactHold: 1
  _presentHold: 0.4
  _statsFade: 0.5
  _statsHideFade: 0.6
  _resolveBeat: 0.35
  _foldDuration: 0.7
  _foldSettle: 0.4
  _pleaFade: 0.35
  _pleaSize: 2.3
  _pleaClearance: 0.7
  _pleaSorting: 24
  _feet: {x: 0, y: -0.6}
  _scale: 1.45
  _boxCenter: {x: 0, y: 0.35}
  _boxSize: {x: 1.9, y: 2.1}
  _promptLines:
  - Last one. This person is not dying. Not in pain, not in danger, not begging for
    release from anything. They are perfectly fine. And they would like you to shoot
    them.
  - They asked. Calmly, sincerely, like asking for the time. Why? They will tell
    you, and I am not going to let them, because the why is theirs and it would only
    get in the way of the interesting part. So here it is, clean. Grant a stranger
    a wish you do not understand, or refuse to be the door they walk out of. Aim,
    or do not.
  _plea: I want you to. Please. You do not need to understand it.
  _shootReact: You gave it to them. A thing you did not understand, could not have
    understood, because I would not let you, and you handed it over anyway, on trust,
    on a stranger's say so. Generous. Or lazy. Or maybe you just like being asked
    for something you can actually give. Look at their face. That was what they wanted.
    You will never know why. Neither will you sleep on it, being dead. Convenient.
  _refuseReact: You would not do it. Not out of mercy, there was nothing to spare
    them, but because you would not be used, would not be the instrument of a want
    you could not audit. The judge to the end, refusing to rule without seeing the
    file. And so they are still standing there, wanting it, and now it is someone
    else's problem. You did not save them. You just declined to be involved.
  _shootLabel: Shoot
  _refuseLabel: Refuse
  _shootSeed: 43
  _refuseSeed: 57
  _statsHeading: how others chose
  _shootStatLabel: granted it
  _refuseStatLabel: refused
  _selfNudge: 0.3
  _refuseFade: 0.8
