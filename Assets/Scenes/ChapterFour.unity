  m_Script: {fileID: 11500000, guid: beccf0a0efce44e1a09664e45782f926, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.EmptyGunBeat
  _note: 16_EmptyGun
  _kit: {fileID: 5000000000000000012}
  _advanceLockout: 0.3
  _reactHold: 1
  _presentHold: 0.4
  _statsFade: 0.5
  _statsHideFade: 0.6
  _resolveBeat: 0.35
  _foldDuration: 0.7
  _foldSettle: 0.4
  _pleaFade: 0.35
  _pleaSize: 2.3
  _pleaClearance: 0.7
  _pleaSorting: 24
  _feet: {x: 0, y: -0.6}
  _scale: 1.45
  _boxCenter: {x: 0, y: 0.35}
  _boxSize: {x: 1.9, y: 2.1}
  _promptLines:
  - Right. This one matters. I need you to understand that before you do anything.
    Of everything I have put in front of you, this is the one that counts, and you
    get exactly one shot, and there is no taking it back.
  - I could tell you who they are and what turns on this, but I think you already
    feel the weight of it, do you not. Look at them. Really look. Now decide, and
    decide carefully, because you will carry this one. Fire, or lower it. Take your
    time. Take all the time you need.
  _reveal: Click. Nothing. There was nothing in it. The gun was never loaded, not
    once, not this whole time, not for a single beat of that little agony I just
    watched you put yourself through. Whatever you decided, nothing was ever going
    to happen. I did not want the shot. I never wanted the shot. I wanted to watch
    you decide. And oh, you did not disappoint.
  _shootLabel: Shoot
  _lowerLabel: Lower the gun
  _shootSeed: 51
  _lowerSeed: 49
  _statsHeading: how others chose
  _shootStatLabel: pulled the trigger
  _lowerStatLabel: lowered the gun
  _clickBeat: 0.5
  _targetFade: 0.6
