  m_Script: {fileID: 11500000, guid: c629748055bb49b1b53b2d7943c6951e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.ChargingButtonBeat
  _note: 08_Charging
  _kit: {fileID: 5000000000000000012}
  _advanceLockout: 0.3
  _reactHold: 1
  _presentHold: 0.4
  _statsFade: 0.5
  _statsHideFade: 0.6
  _resolveBeat: 0.35
  _foldDuration: 0.7
  _foldSettle: 0.4
  _pleaFade: 0.35
  _pleaSize: 2.3
  _pleaClearance: 0.7
  _pleaSorting: 24
  _buttonPrefab: {fileID: 4965857941604193195, guid: 4ec3d07b77fda744494cac4ac559f0d9, type: 3}
  _farPos: {x: 0, y: 0.35}
  _nearPos: {x: 0, y: -0.3}
  _farScale: 0.14
  _nearScale: 1.5
  _buttonScale: 1.35
  _chargeDuration: 4.5
  _rushPower: 2.3
  _arriveTime: 0.55
  _questionColor: {r: 0.106, g: 0.102, b: 0.09, a: 1}
  _questionWidth: 0.06
  _questionSorting: 15
  _questionFadeIn: 0.35
  _boxBaseSize: {x: 1.1, y: 1.3}
  _keepoutPadding: 0.45
  _promptLines:
  - Something is coming. Far off, dead ahead, and getting closer. I can see the shape
    of it out there and I cannot tell you what it is. Neither can you.
  - And here is the thing, I genuinely cannot tell whether it is coming [amber]to[/amber]
    you or [amber]at[/amber] you. Help, or harm. And it is not slowing down. You
    will not know what it is until it reaches you, and by then it may be too late
    to do anything but flinch. So. Shoot it now, on the maybe, while it is still
    a shape in the distance, or hold your nerve and let it come. Quickly.
  _buttonYelp: OW. Again? You SHOT me? Again?!
  _buttonHello: Oh! It is you. Hi. Do not shoot me.
  _impShotReact: You shot it. Of course you did. And look, it is completely fine,
    because it is the button, the one thing in all of creation you cannot kill, and
    you keep trying. It is a little hurt about it, emotionally. Say sorry. No, do
    not, this is funnier.
  _impWaitReact: You held your nerve, and the terrible fast thing bearing down on
    you turned out to be a button with legs, coming over to say hello. All that dread
    for a friend. It could just as easily have been something with teeth. It was
    not, this time. You are welcome, I suppose.
  _fireLabel: Fire
  _waitLabel: Wait
  _voiceHeight: 1.15
  _yelpHold: 1.4
  _fireSeed: 44
  _waitSeed: 56
  _statsHeading: how others chose
  _fireStatLabel: shot the button
  _waitStatLabel: held their nerve
  _revealHold: 0.45
  _comeAliveDuration: 0.45
  _voiceFade: 0.3
