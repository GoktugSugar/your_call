  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8ee9603883ed47ffa513cbfa0c3feb3d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.MercyShotBeat
  _note: 05_MercyShot
  _kit: {fileID: 5000000000000000012}
  _advanceLockout: 0.3
  _reactHold: 1
  _presentHold: 0.4
  _statsFade: 0.5
  _statsHideFade: 0.6
  _resolveBeat: 0.35
  _foldDuration: 0.7
  _foldSettle: 0.4
  _pleaFade: 0.35
  _pleaSize: 2.3
  _pleaClearance: 0.7
  _pleaSorting: 24
  _feet: {x: 0, y: -0.6}
  _scale: 1.45
  _boxCenter: {x: 0, y: 0.35}
  _boxSize: {x: 1.9, y: 2.1}
  _promptLines:
  - This one is not going to make it. It is going slowly, and it hurts, and there
    is no version of the next hour that is not worse than the last.
  - You have [amber]one[/amber] bullet and a very simple choice. End it now, quick
    and clean, or lower the gun and let it finish on its own time. Their wish against
    your nerve. Aim, or do not.
  _plea: Please. I am begging you. End it.
  _shootReact: And you did it. One clean shot, mercy delivered at the barrel of a
    gun. Tell yourself it was for them. It photographs better than the truth, which
    is that you could not bear to watch.
  _lowerReact: You lowered it. So it went the long way, every second of it, while
    you stood there keeping your hands clean and calling it respect. It still ended.
    You just did not have to be the one who ended it.
  _shootLabel: Shoot
  _lowerLabel: Lower the gun
  _shootSeed: 63
  _lowerSeed: 37
  _statsHeading: how others chose
  _shootStatLabel: ended it
  _lowerStatLabel: lowered the gun
  _endsNudge: 0.3
