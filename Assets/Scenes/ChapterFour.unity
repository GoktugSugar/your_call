MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5100000000000000170}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ea45832cf80cb949b54bcc01f3dc5e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.ImpLineBeat
  _note: 17_ImpCloser
  _lines:
  - 'And that is the gun. Ten times a finger on a trigger, and nothing between the thought and the thing but you.'
  - 'You told me a great deal just now. More than the tracks did, more than the buttons. A gun is like that. Terribly honest, for such a dishonest little object.'
  - 'Lower your hand. Rest it. There is more, of course. There is always more.'
  _clickLockout: 0.25
  _clearAtEnd: 0
