  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ea45832cf80cb949b54bcc01f3dc5e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.ImpLineBeat
  _note: 
  _lines:
  - Oh, you are awake. Do not thank me, and do not ask where here is, because I will
    not tell you and you would not much enjoy the answer.
  - You are dead. That part is not up for appeal. You steered a car into the next
    world with a skinful of wine in you, Your Honour, and now you are on the wrong
    side of the bench for once.
  - I have a little game. A long line of questions, and not one of them has a right
    answer, whatever your gut starts screaming. I am not here to weigh your soul.
    I am far nosier than that. I am working out who you actually are.
  - You spent a whole career deciding what strangers deserved. Let us see how you
    like the chair. Do try to keep up.
  _clickLockout: 0.3
  _clearAtEnd: 0
