  m_Script: {fileID: 11500000, guid: 6ea45832cf80cb949b54bcc01f3dc5e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.ImpLineBeat
  _note: 22_Closer
  _lines:
  - That will do for a first sitting. You have told me a great deal more than you
    meant to, which is rather the whole point of the exercise.
  - Do not go looking for the door. There is no door. There is only me, the next
    question, and however long it takes me to finish reading you. Sleep well, Your
    Honour. We are barely started.
  _clickLockout: 0.25
  _clearAtEnd: 0
