  m_Script: {fileID: 11500000, guid: 6ea45832cf80cb949b54bcc01f3dc5e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.ImpLineBeat
  _note: 
  _lines:
  - And that is the lot. A dead man, sizing up gorillas and wasps and a hundred angry
    toddlers like his whole afterlife hung on it. It did not, for the record. Not
    one of those told me a single thing about your soul.
  - But it was fun. Admit it. Go on. Right. Back to work, both of us.
  _clickLockout: 0.25
  _clearAtEnd: 0
