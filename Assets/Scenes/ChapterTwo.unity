  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.WalkingButtonBeat
  _note: 
  _buttonPrefab: {fileID: 4965857941604193195, guid: 4ec3d07b77fda744494cac4ac559f0d9, type: 3}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _buttonPosition: {x: 0, y: 0}
  _buttonScale: 1.1
  _pressRadius: 0.62
  _pressDuration: 0.14
  _keepoutPadding: 0.45
  _voiceSize: 2.3
  _voiceColor: {r: 0.106, g: 0.102, b: 0.09, a: 1}
  _voiceHeight: 1.15
  _voiceSorting: 26
  _pressSeed: 58
  _leaveSeed: 42
  _statsHeading: how others chose
  _pressStatLabel: pressed it
  _leaveStatLabel: left it be
  _setupLines:
  - Last one. And this time, honestly, I have no idea what it does.
  - A plain button. No trick, no catch, no tidy little lesson at the end. Even I
    do not know. Press it, or do not. Genuinely your call.
  _leftReact: You did not press it. The one button in this entire place with nothing
    whatsoever riding on it, and you still could not make yourself. You are exhausting,
    and I mean that with real affection.
  _buttonYelp: Ow! Fuck. That actually hurt, you absolute prick.
  _buttonMutter: Unbelievable. I did nothing to you. Nothing.
  _impSurprised: What. What was. Hold on, that is not. It has never done that. It
    does not do things.
  _impRecover: Right. Well. That has never happened, not once, and I have been at
    this an extremely long time. Let us both agree we did not see it, and move along.
  _pressLabel: Press it
  _leaveLabel: Leave it
  _advanceLockout: 0.3
  _comeAliveDuration: 0.45
  _yelpHold: 1.3
  _surpriseHold: 0.5
  _recoverHold: 0.4
  _voiceFade: 0.3
  _statsFade: 0.5
  _statsHideFade: 0.6
