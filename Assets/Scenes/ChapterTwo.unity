  m_Script: {fileID: 11500000, guid: 6ea45832cf80cb949b54bcc01f3dc5e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.ImpLineBeat
  _note: 
  _lines:
  - Oh, we are not finished. Sit back down. The tracks were only the warm up.
  - This next part is simpler. Buttons. You press them, or you do not. Every one
    of them offers you something lovely, and someone always pays for it. Sometimes
    a stranger. Sometimes you. Let us find out what you will reach for.
  _clickLockout: 0.25
  _clearAtEnd: 0
