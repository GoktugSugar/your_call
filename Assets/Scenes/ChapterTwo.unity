  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.CancerNukeButtonBeat
  _note: 
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
