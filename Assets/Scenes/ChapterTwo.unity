  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YourCall.TimerButtonBeat
  _note: 
  _seconds: 10
  _inkMaterial: {fileID: 2100000, guid: 5556814e11032244ab3e6a5098e86fae, type: 2}
  _font: {fileID: 11400000, guid: 579a746deee295d4682ed64faa1cf59d, type: 2}
  _buttonPosition: {x: 0, y: -0.3}
  _buttonRadius: 0.85
  _lineWidth: 0.055
  _buttonInk: {r: 0.106, g: 0.102, b: 0.09, a: 1}
  _buttonHot: {r: 0.91, g: 0.584, b: 0.118, a: 1}
  _buttonLabel: press
  _buttonLabelSize: 2.6
  _sortingOrder: 14
  _countAnchor: {x: 0, y: 2.1}
  _countSize: 6.5
  _countColor: {r: 0.106, g: 0.102, b: 0.09, a: 1}
  _pressSeed: 64
  _waitSeed: 36
  _statsHeading: how others chose
  _pressLabel: pressed it
  _waitLabel: sat on their hands
  _riskNudge: 0.2
  _ruleLines:
  - New game. One button. Press it and nothing happens to you. Not now, not ever.
  - Do not press it, let the [amber]ten seconds[/amber] run out, and nothing happens
    either. There is a catch. Oh, there is absolutely a catch. I am simply not going
    to tell you what it is. Clock starts now.
  _needleLines:
  - You are really going to want to think about this one.
  - The catch. You are forgetting about the catch.
  - Tick. Tick. Whatever will you do.
  - Half gone. No pressure.
  - Last chance to be clever about it.
  _pressedReveal: You pressed it. And nothing happened. Nothing was ever going to
    happen. There was no catch, there was just you, jabbing a button because you
    could not stand not knowing.
  _waitedReveal: Time. And nothing happened. Nothing was ever going to happen. There
    was no catch, there was just you, frozen stiff over a button that did nothing,
    sweating out ten whole seconds of your endless death.
  _revealHold: 0.4
  _statsFade: 0.5
  _statsHideFade: 0.6
  _advanceLockout: 0.3
  _buttonFade: 0.35
